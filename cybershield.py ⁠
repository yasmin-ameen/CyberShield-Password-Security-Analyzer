# ============================================================
# CyberShield - Personal Password Security Analyzer
# ============================================================

import json
import math
import secrets
import string
from datetime import datetime
from getpass import getpass


# ============================================================
# Data
# ============================================================

COMMON_PASSWORDS = {
    "password", "password1", "password123", "123456", "12345678",
    "123456789", "qwerty", "qwerty123", "admin", "admin123",
    "welcome", "welcome1", "letmein", "iloveyou", "abc123",
    "123123", "monkey", "dragon", "football", "sunshine",
    "master", "saudi123", "ksa12345", "mohammed", "ahmed123",
}

KEYBOARD_PATTERNS = [
    "qwer", "wert", "erty", "rtyu", "asdf", "sdfg", "dfgh",
    "zxcv", "xcvb", "1qaz", "qaz", "2wsx",
]

SENSITIVE_WORDS = [
    "password", "admin", "administrator", "qwerty", "welcome",
    "login", "user", "root", "secret", "security", "cyber", "letmein",
]

# Common character substitutions (leetspeak): p@ssw0rd -> password
LEET_MAP = str.maketrans({
    "@": "a", "4": "a", "0": "o", "3": "e",
    "$": "s", "5": "s", "7": "t", "1": "i", "!": "i",
})

SPECIAL_CHARS = "!@#$%^&*"


# ============================================================
# Helper checks
# ============================================================

def normalize(password):
    """Lowercase + undo common leetspeak substitutions."""
    return password.lower().translate(LEET_MAP)


def strip_trailing(password):
    """Remove trailing digits/symbols: 'Password1!' -> 'password'."""
    return password.lower().rstrip(string.digits + string.punctuation)


def is_common(password):
    candidates = {
        password.lower(),
        normalize(password),
        strip_trailing(password),
        strip_trailing(normalize(password)),
    }
    return any(c in COMMON_PASSWORDS for c in candidates)


def has_easy_pattern(password, run_length=4):
    """Detect sequences (abcd, 4321), repeats (aaaa) and keyboard walks."""
    s = password.lower()

    for pattern in KEYBOARD_PATTERNS:
        if pattern in s:
            return True

    for i in range(len(s) - run_length + 1):
        chunk = s[i:i + run_length]
        if not chunk.isalnum():
            continue
        if len(set(chunk)) == 1:
            return True
        steps = [ord(chunk[j + 1]) - ord(chunk[j]) for j in range(run_length - 1)]
        if all(step == 1 for step in steps) or all(step == -1 for step in steps):
            return True

    return False


def contains_username(username, password):
    """Ignore very short usernames to avoid false positives."""
    u = username.strip().lower()
    return len(u) >= 3 and u in password.lower()


def contains_sensitive_word(password):
    variants = {password.lower(), normalize(password)}
    return any(word in v for word in SENSITIVE_WORDS for v in variants)


def estimate_entropy(password):
    """Upper-bound entropy estimate in bits, based on character pool size."""
    pool = 0
    if any(c.islower() for c in password):
        pool += 26
    if any(c.isupper() for c in password):
        pool += 26
    if any(c.isdigit() for c in password):
        pool += 10
    if any(not c.isalnum() for c in password):
        pool += 32
    return round(len(password) * math.log2(pool), 1) if pool else 0.0


# ============================================================
# Analysis & scoring
# ============================================================

def compute_score(length, has_upper, has_lower, has_digit, has_special,
                  common, pattern, user_found, sensitive):
    score = 0

    # Length (max 40)
    if length >= 8:
        score += 10
    if length >= 12:
        score += 15
    if length >= 16:
        score += 15

    # Variety (max 45)
    score += 10 if has_upper else 0
    score += 10 if has_lower else 0
    score += 10 if has_digit else 0
    score += 15 if has_special else 0

    # Bonus for no weaknesses (15)
    if not (common or pattern or user_found or sensitive):
        score += 15

    # Penalties
    if sensitive:
        score -= 20
    if pattern:
        score -= 15
    if user_found:
        score -= 15
    if common:
        score = min(score, 25)  # a common password can never score well

    return max(0, min(score, 100))


def score_to_level(score):
    if score >= 90:
        return "Excellent"
    if score >= 75:
        return "Strong"
    if score >= 60:
        return "Good"
    return "Weak"


def analyze(username, password):
    length = len(password)
    has_upper = any(c.isupper() for c in password)
    has_lower = any(c.islower() for c in password)
    has_digit = any(c.isdigit() for c in password)
    has_special = any(not c.isalnum() for c in password)

    common = is_common(password)
    pattern = has_easy_pattern(password)
    user_found = contains_username(username, password)
    sensitive = contains_sensitive_word(password)

    score = compute_score(length, has_upper, has_lower, has_digit,
                          has_special, common, pattern, user_found, sensitive)

    return {
        "length": length,
        "has_upper": has_upper,
        "has_lower": has_lower,
        "has_digit": has_digit,
        "has_special": has_special,
        "common": common,
        "pattern": pattern,
        "username_found": user_found,
        "sensitive": sensitive,
        "entropy": estimate_entropy(password),
        "score": score,
        "level": score_to_level(score),
    }


def get_suggestions(r):
    tips = []
    if r["length"] < 12:
        tips.append("Use at least 12 characters.")
    if not r["has_upper"]:
        tips.append("Add at least one uppercase letter.")
    if not r["has_lower"]:
        tips.append("Add at least one lowercase letter.")
    if not r["has_digit"]:
        tips.append("Add at least one number.")
    if not r["has_special"]:
        tips.append("Add at least one special character.")
    if r["common"]:
        tips.append("Avoid commonly used passwords (even with a number or symbol added).")
    if r["pattern"]:
        tips.append("Avoid sequences, repeated characters and keyboard patterns.")
    if r["username_found"]:
        tips.append("Do not use your username inside your password.")
    if r["sensitive"]:
        tips.append("Avoid common words like password, admin or login (even as p@ssw0rd).")
    return tips


# ============================================================
# Password generator
# ============================================================

def generate_strong_password(length=16):
    length = max(length, 12)
    all_chars = string.ascii_letters + string.digits + SPECIAL_CHARS

    while True:
        chars = [
            secrets.choice(string.ascii_uppercase),
            secrets.choice(string.ascii_lowercase),
            secrets.choice(string.digits),
            secrets.choice(SPECIAL_CHARS),
        ] + [secrets.choice(all_chars) for _ in range(length - 4)]

        secrets.SystemRandom().shuffle(chars)
        candidate = "".join(chars)

        # Re-generate in the rare case it contains a weak pattern
        if analyze("", candidate)["score"] >= 90:
            return candidate


# ============================================================
# Reports (the password itself is never saved)
# ============================================================

def clean_filename(value):
    allowed = string.ascii_letters + string.digits + "_-"
    cleaned = "".join(c if c in allowed else "_" for c in value.strip())
    return cleaned or "user"


def save_text_report(username, result):
    filename = f"cybershield_report_{clean_filename(username)}.txt"
    try:
        with open(filename, "w", encoding="utf-8") as f:
            f.write("=" * 55 + "\n")
            f.write("       CYBERSHIELD - PASSWORD SECURITY REPORT\n")
            f.write("=" * 55 + "\n")
            f.write(f"Date: {datetime.now():%Y-%m-%d %H:%M}\n")
            f.write(f"Username: {username}\n")
            f.write(f"Password Length: {result['length']}\n")
            f.write(f"Estimated Entropy: {result['entropy']} bits\n")
            f.write(f"Strength Score: {result['score']} / 100\n")
            f.write(f"Security Level: {result['level']}\n")
            f.write("-" * 55 + "\n")
            f.write("Generated by CyberShield Security Tool\n")
        print(f"📄 Text report saved: {filename}")
    except OSError as e:
        print(f"❌ Error saving text report: {e}")


def save_json_report(username, result):
    filename = f"cybershield_report_{clean_filename(username)}.json"
    data = {
        "tool": "CyberShield",
        "date": datetime.now().isoformat(timespec="seconds"),
        "username": username,
        "password_length": result["length"],
        "estimated_entropy_bits": result["entropy"],
        "strength_score": result["score"],
        "security_level": result["level"],
    }
    try:
        with open(filename, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=4, ensure_ascii=False)
        print(f"📊 JSON report saved: {filename}")
    except OSError as e:
        print(f"❌ Error saving JSON report: {e}")


# ============================================================
# Display
# ============================================================

def yes_no(value):
    return "Yes" if value else "No"


def print_report(r):
    print("\n📊 Basic Analysis")
    print("📏 Length:", r["length"])
    print("🔠 Uppercase:", yes_no(r["has_upper"]))
    print("🔡 Lowercase:", yes_no(r["has_lower"]))
    print("🔢 Number:", yes_no(r["has_digit"]))
    print("🔣 Special character:", yes_no(r["has_special"]))
    print("🧮 Estimated entropy:", r["entropy"], "bits")

    print("\n🔍 Weakness Checks")
    print("⚠️ Common password" if r["common"] else "✅ Not a common password")
    print("⚠️ Easy pattern found" if r["pattern"] else "✅ No easy patterns")
    print("⚠️ Contains your username" if r["username_found"] else "✅ Username not used")
    print("⚠️ Contains sensitive word" if r["sensitive"] else "✅ No sensitive words")

    print("\n" + "=" * 55)
    print("🛡️ Security Score:", r["score"], "/ 100")
    print("🔐 Security Level:", r["level"])

    tips = get_suggestions(r)
    print("\n💡 Improvement Suggestions")
    if tips:
        for tip in tips:
            print("🔹", tip)
    else:
        print("✅ No major improvements needed.")


# ============================================================
# Main
# ============================================================

def main():
    print("=" * 55)
    print("🛡️ Welcome to CyberShield!")
    print("🔐 Personal Password Security Analyzer")
    print("=" * 55)

    username = input("\n👤 Enter your username: ")
    password = getpass("🔑 Enter your password (hidden): ")

    result = analyze(username, password)
    print_report(result)

    print("\n" + "=" * 55)
    print("🔐 Strong Password Generator")
    generated = generate_strong_password()
    gen_result = analyze("", generated)
    print("🔐 Generated Password:", generated)
    print("📏 Length:", gen_result["length"], "| 🛡️ Score:", gen_result["score"], "/ 100")

    print()
    save_text_report(username, result)
    save_json_report(username, result)

    print("\n" + "=" * 55)
    print("👋 Thank you for using CyberShield!")
    print("=" * 55)


if __name__ == "__main__":
    main()
